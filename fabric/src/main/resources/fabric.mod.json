  "authors": [
    "amaranth",
    "phit",
    "SpongePowered contributors"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/feelgoodtps",
    "issues": "https://github.com/Stonebound/FeelGoodTps/issues",
    "sources": "https://github.com/Stonebound/FeelGoodTps"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.stonebound.feelgoodtps.fabric.FeelGoodTpsFabric"
    ]
  },
  "mixins": [
    "feelgoodtps.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
